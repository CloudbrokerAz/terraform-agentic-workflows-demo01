{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash scripts/hooks/tf-guard.sh fix",
        "timeoutSec": 60
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash scripts/hooks/tf-guard.sh verify",
        "timeoutSec": 120
      }
    ]
  }
}
