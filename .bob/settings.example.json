{
  "_comment": [
    "Reference approval config for running these workflows in IBM Bob IDE.",
    "Copy the 'approval' block into ~/.bob/settings/settings.json (note the",
    "nested settings/ directory - ~/.bob/settings.json is a different file and",
    "approval config placed there is ignored). See README-approvals.md.",
    "",
    "This is a DEV/DEMO profile. It auto-approves language runtimes (python3,",
    "uvx, pip) and bash, which together permit arbitrary code execution without",
    "a prompt. Use it on throwaway clones, not on trees holding long-lived",
    "credentials."
  ],
  "approval": {
    "autoApprovalEnabled": true,
    "allowed_permissions": [
      "read",
      "edit",
      "execute",
      "mcp",
      "mode",
      "subtask",
      "subagent",
      "skill",
      "todo",
      "artifact"
    ],
    "permissionOptions": [
      {
        "groupId": "read",
        "enableOutsideWorkspace": true
      },
      {
        "groupId": "edit",
        "enableOutsideWorkspace": true
      }
    ],
    "allowedExecutors": [
      {
        "toolId": "execute_command",
        "approvedCommands": [
          "bash",
          "sh",
          "zsh",
          "[",
          "test",
          "true",
          "false",
          "cd",
          "sleep",
          "cat",
          "head",
          "tail",
          "ls",
          "tree",
          "find",
          "stat",
          "file",
          "basename",
          "dirname",
          "realpath",
          "pwd",
          "mkdir",
          "touch",
          "cp",
          "mv",
          "ln",
          "du",
          "df",
          "wc",
          "diff",
          "column",
          "grep",
          "rg",
          "sed",
          "awk",
          "cut",
          "sort",
          "uniq",
          "tr",
          "jq",
          "yq",
          "xargs",
          "tee",
          "echo",
          "printf",
          "which",
          "type",
          "env",
          "date",
          "uname",
          "whoami",
          "hostname",
          "git",
          "gh",
          "terraform",
          "tofu",
          "tflint",
          "terraform-docs",
          "checkov",
          "trivy",
          "go",
          "node",
          "npm",
          "npx",
          "yarn",
          "pnpm",
          "python3",
          "python",
          "pip",
          "pip3",
          "uv",
          "uvx",
          "make",
          "docker",
          "podman",
          "shellcheck",
          "pre-commit",
          "curl",
          "golangci-lint"
        ],
        "deniedCommands": [
          "rm",
          "sudo",
          "shutdown",
          "reboot",
          "mkfs",
          "dd",
          "gh repo delete",
          "gh auth logout",
          "git push --force",
          "git push -f",
          "git reset --hard",
          "terraform destroy",
          "npm publish"
        ]
      }
    ],
    "editApprovalPreviewMode": "editor"
  }
}
