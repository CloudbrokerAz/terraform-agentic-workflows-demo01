# Copy to evals/e2e/.env and fill in. Sourced by bin/run-suite.sh and bin/run-eval.sh.

# --- GitHub (throwaway eval repos) ---
# Account/org where per-case throwaway repos are created (and deleted after the run).
# The gh token needs the delete_repo scope: gh auth refresh -h github.com -s delete_repo
EVAL_GITHUB_ACCOUNT=
# Template repo (owner/name) the throwaway repos are generated from.
# MUST be a template mirror of this repo including .claude/ (skills, agents) —
# both the workflow run and the judge load their instructions from the clone.
EVAL_TEMPLATE_REPO=

# --- HCP Terraform (consumer-track sandbox deploys) ---
# Token with permission to read/queue/destroy runs in the sandbox project.
TFE_TOKEN=
TFE_ADDR=https://app.terraform.io
EVAL_HCP_ORG=hashi-demos-apj

# --- Runtime (claude-code adapter) ---
# Model override for the workflow run. Empty = Claude Code default.
EVAL_MODEL=
# Model used for the independent judge (cheap, Sonnet-class recommended).
JUDGE_MODEL=claude-sonnet-5

# --- Test/debug knobs (rarely needed) ---
# EVAL_JUDGE_MOCK=1   run the real judge even under --adapter mock
# MOCK_FAIL=1         make the mock adapter report an agent error
# MOCK_SLEEP_SECS=30  make the mock adapter linger (interrupt testing)
