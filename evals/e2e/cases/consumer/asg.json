{
  "id": "consumer-asg",
  "track": "consumer",
  "description": "Auto-scaling group + launch template + ALB with health checks + CloudWatch dashboards",
  "prompt_file": ".claude/skills/tf-consumer-e2e/prompts/consumer_asg.md",
  "tags": [
    "consumer",
    "deploy",
    "aws",
    "standard"
  ],
  "timeout_minutes": 120,
  "runtime": {
    "adapter": "claude-code",
    "model": "",
    "max_turns": 300
  },
  "sandbox": {
    "deploy": true,
    "hcp_org": "hashi-demos-apj",
    "workspace_pattern": "sandbox_consumer_asg{SUFFIX}"
  },
  "expected_artifacts": [
    "specs/*/consumer-design.md",
    "specs/*/research-*.md",
    "specs/*/reports/deployment-report.md",
    "*.tf"
  ],
  "deterministic_checks": [
    "artifacts",
    "terraform_fmt",
    "terraform_validate",
    "tflint",
    "trivy",
    "issue_created",
    "pr_created",
    "checklist_complete",
    "destroy_clean"
  ],
  "judge": {
    "rubric": "consumer",
    "min_score": 7.0,
    "assertions": [
      "ASG uses a launch template (not a launch configuration) from a private registry module",
      "Target-tracking scaling policies are configured",
      "ALB health checks span 2 availability zones",
      "CloudWatch dashboards for monitoring exist",
      "Region is ap-southeast-2 and the existing default VPC is used"
    ]
  }
}
